<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZoneQuanta</AssemblyName>
    <RootNamespace>ZoneQuanta</RootNamespace>
    <Version>1.2.8</Version>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Product>ZoneQuanta</Product>
    <Authors>Aevorine</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Flavor Condition="'$(Flavor)' == ''">full</Flavor>
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EventSourceSupport>false</EventSourceSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Flavor)' == 'full'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Flavor)' != 'full'">
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Diagnostics.Tracing.TraceEvent.dll" />
  </ItemGroup>

  <Target Name="PruneTraceEventExtras" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'msdia140' Or '%(Filename)' == 'KernelTraceControl' Or '%(Filename)' == 'KernelTraceControl.Win61' Or '%(Filename)' == 'Dia2Lib' Or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64' Or '%(Filename)' == 'Microsoft.Diagnostics.NETCore.Client' Or $([System.String]::new('%(Filename)').StartsWith('Microsoft.Extensions.'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Flavor</_Parameter1>
      <_Parameter2>$(Flavor)</_Parameter2>
    </AssemblyAttribute>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
  </ItemGroup>

</Project>
