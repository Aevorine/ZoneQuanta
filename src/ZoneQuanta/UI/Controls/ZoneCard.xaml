<UserControl x:Class="ZoneQuanta.UI.Controls.ZoneCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ZoneQuanta.UI.Controls">
    <Border x:Name="Root" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,10,14,10" Margin="3"
            RenderTransformOrigin="0.5,0.5" Cursor="Hand">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="FlipScale" ScaleX="1"/>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
                <SkewTransform x:Name="TiltSkew"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Border x:Name="Glow" IsHitTestVisible="False" CornerRadius="10" Opacity="0" Margin="-14,-10"/>
            <Grid x:Name="Front">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabelText" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="TagText" Grid.Column="1" Style="{StaticResource Muted}" FontSize="11"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,2">
                    <c:RollingText x:Name="Main" TextElement.FontSize="44" TextElement.FontWeight="Light"
                                   TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontFamily="{StaticResource AppFont}"/>
                    <StackPanel VerticalAlignment="Bottom" Margin="6,0,0,9">
                        <TextBlock x:Name="AmPmText" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left"/>
                        <c:RollingText x:Name="Secs" TextElement.FontSize="20" TextElement.FontWeight="Light"
                                       TextElement.Foreground="{DynamicResource MutedBrush}" TextElement.FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>
                </StackPanel>

                <c:DayBar x:Name="Arc" Grid.Row="2" Margin="0,4,0,2" HorizontalAlignment="Stretch"/>

                <StackPanel Grid.Row="3" Margin="0,2,0,0">
                    <TextBlock x:Name="DateText" FontSize="13"/>
                    <TextBlock x:Name="OffsetText" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="Back" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="BackName" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="BackState" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="BackNext" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="BackSun" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="BackYear" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
