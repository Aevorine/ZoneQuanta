<UserControl x:Class="ZoneQuanta.UI.Panel.Pages.QuickPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ZoneQuanta.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12" c:Arrange.Key="quick.cards">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border c:Arrange.Id="features" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
                <StackPanel x:Name="Features" c:Arrange.Key="quick.features">
                    <ToggleButton Style="{StaticResource SwitchRow}" Content="资源管理器右键添加" IsChecked="{Binding QuickContextMenu, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource SwitchRow}" Content="打开后自动收起" IsChecked="{Binding QuickCloseAfterOpen, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource SwitchRow}" Content="托盘菜单显示" IsChecked="{Binding QuickInTray, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource SwitchRow}" Content="同步「开始」固定的应用" IsChecked="{Binding QuickStartSync, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource SwitchRow}" Content="自动分类" IsChecked="{Binding QuickAutoGroup, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" c:Arrange.Id="view" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14,10,8">
                <StackPanel>
                    <TextBlock Text="显示" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                    <WrapPanel x:Name="Fields"/>
                    <TextBlock Text="排序" Style="{StaticResource Heading}" Margin="0,8,0,10"/>
                    <UniformGrid x:Name="Sorts" Rows="1" Margin="0,0,8,6"/>
                    <DockPanel Margin="0,8,8,10">
                        <Button x:Name="ResetSize" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Reset}" ToolTip="恢复默认大小" Margin="0,-8,-6,-8"/>
                        <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" ToolTip="快捷面板大小"/>
                        <TextBlock Text="打开位置" Style="{StaticResource Heading}"/>
                    </DockPanel>
                    <UniformGrid x:Name="Places" Rows="1" Margin="0,0,8,6"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12,14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Style="{StaticResource IconField}" Tag="{StaticResource Icon.Search}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="GroupMode" Style="{StaticResource IconToggle}" Tag="{StaticResource Icon.Groups}" ToolTip="分组"/>
                    <ToggleButton x:Name="TileMode" Style="{StaticResource IconToggle}" Tag="{StaticResource Icon.Grid}" ToolTip="网格"/>
                    <ToggleButton x:Name="ListMode" Style="{StaticResource IconToggle}" Tag="{StaticResource Icon.List}" ToolTip="列表" Margin="0,0,10,0"/>
                    <Button x:Name="AddFiles" Style="{StaticResource Action}" Content="添加文件" Margin="0,0,6,0"/>
                    <Button x:Name="AddFolder" Style="{StaticResource Action}" Content="添加文件夹" Margin="0,0,6,0"/>
                    <Button x:Name="OpenQuick" Style="{StaticResource Primary}" Content="快捷面板"/>
                </StackPanel>
                <ContentPresenter x:Name="GridHost" c:Arrange.Ignore="True" Grid.Row="1" Grid.ColumnSpan="2" Margin="-2,10,-2,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
