<UserControl x:Class="ZoneQuanta.UI.Panel.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
            <UniformGrid Columns="1" VerticalAlignment="Top">
                <ToggleButton Style="{StaticResource SwitchRow}" Content="开机自启" IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="全屏时隐藏" IsChecked="{Binding HideOnFullscreen, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="总是置顶" IsChecked="{Binding Topmost, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="鼠标穿透" IsChecked="{Binding ClickThrough, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="锁定位置" IsChecked="{Binding LockPosition, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="允许超出屏幕边界" IsChecked="{Binding AllowOffScreen, Mode=TwoWay}"/>
            </UniformGrid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="显示 / 隐藏面板快捷键" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                <TextBox x:Name="HotkeyBox" Grid.Row="1" Style="{StaticResource Field}" IsReadOnly="True" Cursor="Hand"/>
                <ToggleButton Grid.Row="2" Style="{StaticResource SwitchRow}" Content="启用快捷键" IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}" Margin="-12,10,-12,0"/>
                <UniformGrid Grid.Row="4" Rows="1">
                    <Button x:Name="FolderButton" Style="{StaticResource Action}" Content="打开配置目录" Margin="0,0,4,0"/>
                    <Button x:Name="ExitButton" Style="{StaticResource Primary}" Content="退出程序" Margin="4,0,0,0"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
