<UserControl x:Class="ZoneQuanta.UI.Panel.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ZoneQuanta.UI.Controls">
    <Grid c:Arrange.Key="system.cards">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*" MinHeight="150"/>
        </Grid.RowDefinitions>

        <Border c:Arrange.Id="switches" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
            <UniformGrid Columns="1" c:Arrange.Key="system.switches">
                <ToggleButton Style="{StaticResource SwitchRow}" Content="开机自启" IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="全屏时隐藏" IsChecked="{Binding HideOnFullscreen, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="总是置顶" IsChecked="{Binding Topmost, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="鼠标穿透" IsChecked="{Binding ClickThrough, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="锁定位置" IsChecked="{Binding LockPosition, Mode=TwoWay}"/>
                <ToggleButton Style="{StaticResource SwitchRow}" Content="允许超出屏幕边界" IsChecked="{Binding AllowOffScreen, Mode=TwoWay}"/>
            </UniformGrid>
        </Border>

        <Border c:Arrange.Id="hotkey" Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="显示 / 隐藏面板快捷键" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                <TextBox x:Name="HotkeyBox" Grid.Row="1" Style="{StaticResource Field}" IsReadOnly="True" Cursor="Hand"/>
                <ToggleButton Grid.Row="2" Style="{StaticResource SwitchRow}" Content="启用快捷键" IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}" Margin="-12,10,-12,10"/>
                <UniformGrid Grid.Row="3" Rows="1">
                    <Button x:Name="FolderButton" Style="{StaticResource Action}" Content="打开配置目录" Margin="0,0,4,0"/>
                    <Button x:Name="ExitButton" Style="{StaticResource Primary}" Content="退出程序" Margin="4,0,0,0"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18,12,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="SnapshotButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Plus}" ToolTip="立即保存当前版本"/>
                    <Button x:Name="HistoryFolder" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Folder}" ToolTip="打开历史版本文件夹"/>
                    <TextBlock Text="历史版本" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,0,0">
                    <StackPanel x:Name="History" Margin="0,0,8,0"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
