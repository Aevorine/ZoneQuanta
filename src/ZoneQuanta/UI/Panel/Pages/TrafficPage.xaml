<UserControl x:Class="ZoneQuanta.UI.Panel.Pages.TrafficPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ZoneQuanta.UI.Controls">
    <Grid c:Arrange.Key="traffic.sections">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="2.4*"/>
        </Grid.RowDefinitions>

        <UniformGrid x:Name="Ranges" Rows="1" Margin="0,0,0,10"/>

        <UniformGrid Grid.Row="1" Rows="1" Margin="-4,0,-4,6" c:Arrange.Key="traffic.stats">
            <Border c:Arrange.Id="up" Style="{x:Null}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="上传" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="UpText" FontSize="24" FontWeight="Light" Foreground="{DynamicResource Accent2Brush}"/>
                </StackPanel>
            </Border>
            <Border c:Arrange.Id="down" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="下载" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="DownText" FontSize="24" FontWeight="Light" Foreground="{DynamicResource Accent1Brush}"/>
                </StackPanel>
            </Border>
            <Border c:Arrange.Id="total" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="合计" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="TotalText" FontSize="24" FontWeight="Light"/>
                </StackPanel>
            </Border>
            <Border x:Name="QuotaCard" c:Arrange.Id="quota" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="4,0" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <c:QuotaRing x:Name="Ring" Width="46" Height="46" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="QuotaLabel" Text="剩余额度" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="QuotaText" FontSize="20" FontWeight="Light" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" c:Arrange.Id="chart" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10" Padding="10,8,10,6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LiveMode" Style="{StaticResource Segment}" Content="实时" GroupName="chart" Width="64" MinHeight="30" Margin="0,0,4,0"/>
                        <RadioButton x:Name="DailyMode" Style="{StaticResource Segment}" Content="每日" GroupName="chart" Width="64"/>
                    </StackPanel>
                    <WrapPanel x:Name="Stats" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <c:SpeedChart x:Name="Chart" Grid.Row="1" Margin="0,6,0,0"/>
                <c:DailyBars x:Name="Bars" Grid.Row="1" Margin="2,6,2,0" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" c:Arrange.Id="apps" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="应用流量" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AppSearch" Grid.Column="1" Style="{StaticResource IconField}" Tag="{StaticResource Icon.Search}" MaxWidth="260" HorizontalAlignment="Right" Width="220" Margin="12,0,10,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <UniformGrid x:Name="GroupBy" Rows="1" Margin="0,0,10,0"/>
                        <UniformGrid x:Name="Sorts" Rows="1"/>
                    </StackPanel>
                </Grid>
                <ContentPresenter x:Name="AppHeader" Grid.Row="1" Margin="0,0,10,4"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="Apps"/>
                </ScrollViewer>
                <UniformGrid Grid.Row="3" Rows="1" Margin="-12,6,-12,-6">
                    <ToggleButton x:Name="TrackToggle" Style="{StaticResource SwitchRow}" Content="应用流量统计" ToolTip="需要管理员授权一次" Margin="0,0,20,0"/>
                    <ToggleButton x:Name="OnlineIconToggle" Style="{StaticResource SwitchRow}" Content="联网补全图标" ToolTip="从程序官网获取图标" IsChecked="{Binding OnlineIcons, Mode=TwoWay}"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Popup x:Name="QuotaPopup" PlacementTarget="{Binding ElementName=QuotaCard}" Placement="Bottom" HorizontalOffset="-150" VerticalOffset="8"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="8,8,8,12" Width="340" Margin="0,0,0,12">
                <StackPanel>
                    <ToggleButton Style="{StaticResource SwitchRow}" Content="流量额度" IsChecked="{Binding QuotaEnabled, Mode=TwoWay}"/>
                    <Grid Margin="12,6,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="每月额度" VerticalAlignment="Center"/>
                        <TextBox x:Name="CapBox" Grid.Column="1" Style="{StaticResource Field}" HorizontalContentAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="GB" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="12,6,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="重置日" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Slider Grid.Column="1" Style="{StaticResource Range}" Minimum="1" Maximum="31" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding QuotaResetDay, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Text="{Binding QuotaResetDay, StringFormat={}{0} 日}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ToggleButton Style="{StaticResource SwitchRow}" Content="用量提醒" IsChecked="{Binding QuotaAlert, Mode=TwoWay}"/>
                    <Grid Margin="12,6,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="提醒阈值" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Slider Grid.Column="1" Style="{StaticResource Range}" Minimum="50" Maximum="99" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding QuotaAlertPercent, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Text="{Binding QuotaAlertPercent, StringFormat={}{0}%}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
