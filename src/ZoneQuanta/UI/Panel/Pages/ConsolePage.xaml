<UserControl x:Class="ZoneQuanta.UI.Panel.Pages.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentPresenter x:Name="Preview" Margin="0,0,0,4"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="3" Margin="-4,0">
            <ToggleButton Style="{StaticResource Tile}" Tag="{StaticResource Icon.Clock}" Content="显示时钟" IsChecked="{Binding WidgetVisible, Mode=TwoWay}"/>
            <ToggleButton Style="{StaticResource Tile}" Tag="{StaticResource Icon.Pointer}" Content="鼠标穿透" IsChecked="{Binding ClickThrough, Mode=TwoWay}"/>
            <ToggleButton Style="{StaticResource Tile}" Tag="{StaticResource Icon.Lock}" Content="锁定位置" IsChecked="{Binding LockPosition, Mode=TwoWay}"/>
            <ToggleButton Style="{StaticResource Tile}" Tag="{StaticResource Icon.Pin}" Content="总是置顶" IsChecked="{Binding Topmost, Mode=TwoWay}"/>
            <ToggleButton Style="{StaticResource Tile}" Tag="{StaticResource Icon.Fullscreen}" Content="全屏时隐藏" IsChecked="{Binding HideOnFullscreen, Mode=TwoWay}"/>
            <ToggleButton Style="{StaticResource Tile}" Tag="{StaticResource Icon.Power}" Content="开机自启" IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="1" Style="{StaticResource Range}" Minimum="0.5" Maximum="2" SmallChange="0.05" LargeChange="0.1" Value="{Binding Scale, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Scale, StringFormat={}{0:P0}}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="不透明度" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="1" Style="{StaticResource Range}" Minimum="0.2" Maximum="1" SmallChange="0.02" LargeChange="0.1" Value="{Binding Opacity, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
